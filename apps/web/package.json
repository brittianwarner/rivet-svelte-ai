{
  "name": "@example/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js dev --port 5173 --strictPort",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "preview": "node build/index.js",
    "check": "node ./node_modules/@sveltejs/kit/svelte-kit.js sync && node ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@example/api": "workspace:*",
    "@example/wire": "workspace:*",
    "@rivetkit/svelte": "workspace:*",
    "@sveltejs/adapter-node": "^5.3.2",
    "@sveltejs/kit": "^2.43.2",
    "rivetkit": "2.3.17",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/node": "^22.18.0",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
