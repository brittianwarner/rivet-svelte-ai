{
  "name": "@example/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173 --strictPort",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "start": "bun ../server/src/main.ts"
  },
  "dependencies": {
    "@example/actors": "workspace:*",
    "@example/entities": "workspace:*",
    "@example/wire": "workspace:*",
    "@rivetkit/svelte": "workspace:*",
    "@sveltejs/kit": "^3.1.1",
    "rivetkit": "3.1.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@example/sveltekit-adapter-bun": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
