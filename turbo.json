{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": ["tsconfig*.json", ".env.example"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "build": {
      "env": ["WEB_ORIGIN"],
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "test:integration": {
      "cache": false
    }
  },
  "boundaries": {
    "tags": {
      "browser": {
        "dependencies": {
          "deny": ["server", "actors", "config"]
        }
      },
      "web": {
        "dependencies": {
          "deny": ["server"]
        }
      }
    }
  }
}
