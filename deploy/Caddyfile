# Local stand-in for Railway's edge: round-robin across the web replicas,
# WebSockets included. web3/web4 are the next release (rehearse-deploy.sh).
:8080 {
	reverse_proxy web1:8080 web2:8080 web3:8080 web4:8080 {
		lb_policy round_robin
		health_uri /healthz
		health_interval 2s
		fail_duration 5s
	}
}
