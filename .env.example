# Everything is optional for local development: `bun run dev` starts a local
# engine, the Bun server (API + /rivet edge) on 3001, and Vite on 5173.

# --- AI (optional) ---------------------------------------------------------
# A non-empty OpenRouter key wins; otherwise Gemini is selected.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- The one server ----------------------------------------------------------
# Serves the web app, /api and /rivet on one port. Containers use HOST=:: and PORT=8080.
PORT=3001
HOST=127.0.0.1
# What this process runs: all (default) | app | engine | runner | front.
# One image; split along these seams to scale tiers separately. See docs/deployment.md.
ROLE=all
# The site's public origin. Browsers may call the API and open actor sockets from it.
# PUBLIC_ORIGIN=https://your-domain
# Extra allowed browser origins (local dev).
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rivet engine ------------------------------------------------------------
# Local development: leave RIVET_ENDPOINT unset and RivetKit runs an engine on 6440.
RIVET_RUN_ENGINE_PORT=6440
# ROLE=app: where the engine services are. Private network only.
# RIVET_ENDPOINT=http://engine.internal:6420
# Engine admin token. Server-side only: the /rivet edge mints short-lived,
# namespace-scoped credentials from it and never forwards it to browsers.
# RIVET_TOKEN=
# RIVET_NAMESPACE=default

# --- Object storage (ROLE=all with replicas, or ROLE=engine) -----------------
# The only external requirement. https only: the engine's S3 client does not
# speak plain http. Virtual-hosted by default (<bucket>.<endpoint host>).
# S3_BUCKET=
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=rivet/
# S3_VIRTUAL_HOSTED=true

# --- Entities ----------------------------------------------------------------
# Signs principal tokens for the organization/user actors. Required in
# production, and identical on every replica. Local dev generates one.
# ENTITY_SECRET=
# How long a project's CSV export stays downloadable. Default: 3600.
# ENTITY_EXPORT_TTL_SECONDS=

# Public demo parameter only: returned to visitors, NOT user authentication.
ACTOR_TOKEN=
