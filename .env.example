# Optional: the counter and learning page work without this file or AI credentials.
# A non-empty OpenRouter key wins; otherwise Gemini is selected.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local HTTP configuration. Set API_HOST=0.0.0.0 inside containers.
API_PORT=3001
API_HOST=127.0.0.1
API_ORIGIN=http://127.0.0.1:3001
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local gateway and runner use 6440 and 6441.
RIVET_RUN_ENGINE_PORT=6440
RIVET_PUBLIC_ENDPOINT=http://127.0.0.1:6440

# Public demo parameter only: this is returned to visitors, NOT user authentication.
ACTOR_TOKEN=

# For remote Rivet, set these using your host's environment configuration.
# Replace RIVET_PUBLIC_ENDPOINT above with the browser-safe public endpoint.
# Never put RIVET_TOKEN or a provider key in browser configuration.
# RIVET_ENDPOINT=
# RIVET_TOKEN=
# RIVET_NAMESPACE=
# RIVET_NODE_VERSION=
