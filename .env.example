# Leave blank to use Gemini. A non-empty OpenRouter key wins.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Gemini Flash. Used when OPENROUTER_API_KEY is blank.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional shared demo token. When set, browser and server clients must pass it.
# This value is returned to the browser. Do not put a model key here.
ACTOR_TOKEN=

# Local engine port. Defaults to 6440 inside the API if unset.
RIVET_RUN_ENGINE_PORT=6440

# Browser actor gateway. Local default matches the engine port above.
# On Rivet Cloud, set this to the public endpoint (pk_ token, not the secret)
# and set RIVET_ENDPOINT, RIVET_TOKEN, and RIVET_NAMESPACE.
RIVET_PUBLIC_ENDPOINT=http://127.0.0.1:6440
