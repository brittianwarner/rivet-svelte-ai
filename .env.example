# Everything is optional for local development. `bun run dev` runs the same
# three services as production: a local engine on 6440 (data in .rivet/engine),
# the api on 3001 (restarts on save; actor state survives), and Vite on 5173.

# --- AI (optional) ---------------------------------------------------------
# A non-empty OpenRouter key wins; otherwise Gemini is selected.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- The server ----------------------------------------------------------------
# One image for every service. Containers use HOST=:: and PORT=8080.
PORT=3001
HOST=127.0.0.1
# What this process runs: all (default) | app | engine | api | web.
# Production: web (public) → api (actors) → engine. See docs/deployment.md.
ROLE=all
# ROLE=web: the api service's private origin.
# API_URL=http://api.internal:8080
# The site's public origin. Browsers may call the API and open actor sockets from it.
# PUBLIC_ORIGIN=https://your-domain
# Vite's port in development. Extra allowed browser origins default to it.
WEB_PORT=5173
# WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rivet engine ------------------------------------------------------------
# Local development: leave RIVET_ENDPOINT unset and a local engine runs on
# ENGINE_PORT, its data in ENGINE_DATA_DIR. One engine per data directory.
ENGINE_PORT=6440
# ENGINE_DATA_DIR=.rivet/engine
# ROLE=app or api: where the engine service is. Private network only.
# RIVET_ENDPOINT=http://engine.internal:6420
# Engine admin token. Server-side only: the /rivet edge mints short-lived,
# namespace-scoped credentials from it and never forwards it to browsers.
# RIVET_TOKEN=
# RIVET_NAMESPACE=default

# --- Engine bucket (ROLE=engine, or ROLE=all with replicas) -------------------
# https only: the engine's S3 client does not speak plain http.
# Virtual-hosted by default (<bucket>.<endpoint host>).
# S3_BUCKET=
# S3_ENDPOINT=https://storage.example.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=rivet/
# S3_VIRTUAL_HOSTED=true

# --- App files bucket (ROLE=api, app or all) ---------------------------------
# Exports and other files actors keep outside their state. Never the engine's
# bucket. Unset in development: files go to FILES_DIR or .rivet/files.
# Production refuses to start without FILES_BUCKET or FILES_DIR.
# FILES_BUCKET=
# FILES_ENDPOINT=https://storage.example.com
# FILES_REGION=auto
# FILES_ACCESS_KEY_ID=
# FILES_SECRET_ACCESS_KEY=
# FILES_PREFIX=
# FILES_VIRTUAL_HOSTED=true
# FILES_DIR=

# --- Entities ----------------------------------------------------------------
# Signs principal tokens for the organization/user actors. Required in
# production, and identical on every replica. Local dev generates one.
# ENTITY_SECRET=
# How long a project's CSV export stays downloadable. Default: 3600.
# ENTITY_EXPORT_TTL_SECONDS=

# Public demo parameter only: returned to visitors, NOT user authentication.
ACTOR_TOKEN=
