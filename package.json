{
  "name": "rivet-svelte-ai",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "check": "turbo check",
    "test": "turbo test",
    "build": "turbo build",
    "validate": "bun run check && bun run test && bun run build && turbo boundaries",
    "test:smoke": "bun apps/server/tests/smoke.ts",
    "test:e2e": "playwright test && playwright test --config playwright.ai.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:production": "bun run build && E2E_PRODUCTION=1 bun run test:e2e",
    "test:deployment": "bun apps/server/tests/deployment.ts",
    "railway:plan": "railway config plan",
    "railway:apply": "railway config apply",
    "test:integration": "turbo run test:integration",
    "start": "bun apps/server/src/main.ts",
    "boundaries": "turbo boundaries"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "railway": "3.16.0",
    "turbo": "^2.11.10"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
