{
  "name": "@rivetkit/svelte",
  "version": "0.1.0",
  "description": "Svelte 5 runes integration for RivetKit actors",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "svelte": "./src/lib/index.ts",
  "types": "./src/lib/index.ts",
  "exports": {
    ".": {
      "types": "./src/lib/index.ts",
      "svelte": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./testing": {
      "types": "./src/lib/testing/index.ts",
      "svelte": "./src/lib/testing/index.ts",
      "default": "./src/lib/testing/index.ts"
    }
  },
  "files": [
    "dist",
    "src/lib",
    "!dist/__bench__",
    "!dist/__tests__",
    "!src/lib/__bench__",
    "!src/lib/__tests__"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check-types": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "vitest run --environment jsdom src/lib/__tests__/*.test.ts",
    "bench": "vitest bench --run --environment jsdom src/lib/__bench__/*.bench.ts"
  },
  "peerDependencies": {
    "rivetkit": "^3.0.1",
    "svelte": "^5.57.3"
  },
  "dependencies": {
    "esm-env": "^1.2.2",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "rivetkit": "3.0.1",
    "@sveltejs/package": "^3.0.2",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "keywords": [
    "rivetkit",
    "svelte",
    "svelte5",
    "runes",
    "actors",
    "realtime",
    "websocket"
  ]
}
